#!/usr/bin/env php
<?php
// bin/syncops
//
// Jedini CLI entrypoint aplikacije.
//
// Upotreba:
//   bin/syncops migrate                  primeni sve neprimenjene migracije
//   bin/syncops migrate:status           prikazi stanje migracija, bez izmena
//   bin/syncops key:generate             generisi vrednost za SECRET_KEY
//   bin/syncops password:hash            generisi APP_PASSWORD_HASH za GUI
//   bin/syncops integrations             izlistaj integracije
//   bin/syncops integration:add          dodaj integraciju (interaktivno)
//   bin/syncops integration:test <id>    proveri konekciju na vCenter
//   bin/syncops collect:dry <id>         prikupi i ispisi, BEZ upisa u bazu
//   bin/syncops discover <id>            prikupi i UPISI u bazu (odmah)
//   bin/syncops discover:queue <id>      stavi u red cekanja
//   bin/syncops discover:queue --all     stavi sve aktivne u red cekanja
//   bin/syncops worker                   obradjuj red cekanja
//   bin/syncops runs:reset <id>          oznaci zaglavljen posao kao neuspeo
//   bin/syncops integration:password <id>  promeni lozinku
//   bin/syncops integration:enable <id>
//   bin/syncops integration:disable <id>
//   bin/syncops help
//
// U Docker okruzenju:
//   docker compose exec app bin/syncops <komanda>

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$root = dirname(__DIR__);

// -----------------------------------------------------------------------
// Autoload
//
// Koristi Composer ako je "composer install" odradjen; u suprotnom
// registruje minimalni PSR-4 autoloader, da CLI radi i bez vendor/ foldera.
// -----------------------------------------------------------------------
$composerAutoload = $root . '/vendor/autoload.php';

if (is_file($composerAutoload)) {
    require $composerAutoload;
} else {
    spl_autoload_register(static function (string $class) use ($root): void {
        $prefix = 'SyncOps\\';

        if (!str_starts_with($class, $prefix)) {
            return;
        }

        $relative = str_replace('\\', '/', substr($class, strlen($prefix)));
        $file     = $root . '/src/' . $relative . '.php';

        if (is_file($file)) {
            require $file;
        }
    });
}

use SyncOps\Core\Db;
use SyncOps\Core\Migrator;
use SyncOps\Core\Secret;
use SyncOps\Integration\Integration;
use SyncOps\Integration\IntegrationRepository;
use SyncOps\Run\DiscoveryRunner;
use SyncOps\Run\RunRepository;
use SyncOps\Run\RunStatus;
use SyncOps\Run\Worker;
use SyncOps\Source\VCenter\Client\ClientFactory;
use SyncOps\Source\VCenter\CollectionResult;
use SyncOps\Source\VCenter\ConnectionTester;
use SyncOps\Source\VCenter\VCenterSource;
use SyncOps\Storage\RawStore;
use SyncOps\Storage\Repository\ClusterRepository;
use SyncOps\Storage\Repository\HostRepository;
use SyncOps\Storage\Repository\VmRepository;
use SyncOps\Web\Auth;

// -----------------------------------------------------------------------
// Pomocne funkcije za ispis i unos
// -----------------------------------------------------------------------
$stdout = static fn (string $line = '') => fwrite(STDOUT, $line . PHP_EOL);
$stderr = static fn (string $line = '') => fwrite(STDERR, $line . PHP_EOL);

/** Procitaj red sa tastature, sa opcionom podrazumevanom vrednoscu. */
$ask = static function (string $question, string $default = ''): string {
    $suffix = $default !== '' ? " [{$default}]" : '';
    fwrite(STDOUT, $question . $suffix . ': ');

    $answer = trim((string) fgets(STDIN));

    return $answer !== '' ? $answer : $default;
};

/** Procitaj lozinku bez ispisivanja na ekran. */
$askSecret = static function (string $question) use ($stdout): string {
    fwrite(STDOUT, $question . ': ');

    $echoDisabled = false;

    if (function_exists('shell_exec') && stripos(PHP_OS_FAMILY, 'win') === false) {
        shell_exec('stty -echo 2>/dev/null');
        $echoDisabled = true;
    }

    $value = trim((string) fgets(STDIN));

    if ($echoDisabled) {
        shell_exec('stty echo 2>/dev/null');
        $stdout('');
    }

    return $value;
};

$askYesNo = static function (string $question, bool $default = false) use ($ask): bool {
    $answer = strtolower($ask($question . ' (da/ne)', $default ? 'da' : 'ne'));

    return in_array($answer, ['da', 'd', 'yes', 'y', '1'], true);
};

$usage = static function () use ($stdout): void {
    $stdout('SyncOPS CLI');
    $stdout();
    $stdout('Migracije:');
    $stdout('  migrate                       Primeni sve neprimenjene migracije');
    $stdout('  migrate:status                Prikazi stanje migracija (bez izmena)');
    $stdout();
    $stdout('Integracije:');
    $stdout('  integrations                  Izlistaj integracije');
    $stdout('  integration:add               Dodaj integraciju (interaktivno)');
    $stdout('  integration:test <id>         Proveri konekciju na vCenter');
    $stdout('  collect:dry <id>              Prikupi i ispisi, bez upisa u bazu');
    $stdout('  discover <id>                 Prikupi i upisi u bazu (odmah)');
    $stdout('  discover:queue <id>|--all     Stavi u red cekanja');
    $stdout('  worker                        Obradjuj red cekanja');
    $stdout('  runs:reset <id>               Oznaci zaglavljen posao kao neuspeo');
    $stdout('  integration:password <id>     Promeni lozinku');
    $stdout('  integration:enable <id>       Aktiviraj');
    $stdout('  integration:disable <id>      Deaktiviraj');
    $stdout();
    $stdout('Ostalo:');
    $stdout('  key:generate                  Generisi vrednost za SECRET_KEY');
    $stdout('  password:hash                 Generisi APP_PASSWORD_HASH za GUI');
    $stdout('  help                          Ovaj ispis');
    $stdout();
};

// -----------------------------------------------------------------------
// Dispatch
// -----------------------------------------------------------------------
$command = $argv[1] ?? 'help';
$argument = $argv[2] ?? null;

$known = [
    'migrate',
    'migrate:status',
    'key:generate',
    'password:hash',
    'integrations',
    'integration:add',
    'integration:test',
    'collect:dry',
    'discover',
    'discover:queue',
    'worker',
    'runs:reset',
    'integration:password',
    'integration:enable',
    'integration:disable',
];

if (in_array($command, ['help', '-h', '--help'], true)) {
    $usage();
    exit(0);
}

if (!in_array($command, $known, true)) {
    $stderr("Nepoznata komanda: {$command}");
    $stderr();
    $usage();
    exit(1);
}

// Ove dve komande ne zahtevaju ni bazu ni konfiguraciju.
if ($command === 'key:generate') {
    $stdout(Secret::generateKey());
    exit(0);
}

if ($command === 'password:hash') {
    $password = $askSecret('Lozinka za pristup GUI-ju');

    if (strlen($password) < 8) {
        $stderr('Lozinka mora imati bar 8 znakova.');
        exit(1);
    }

    if ($askSecret('Ponovi lozinku') !== $password) {
        $stderr('Lozinke se ne poklapaju.');
        exit(1);
    }

    $stdout();
    $stdout('Upisi ovo u .env, pod jednostrukim navodnicima (hash sadrzi znak $):');
    $stdout();
    $stdout("APP_PASSWORD_HASH='" . Auth::hashPassword($password) . "'");
    $stdout();
    $stdout('Zatim: docker compose restart app');
    exit(0);
}

$config = null;

try {
    /** @var array{db: array<string, mixed>, paths: array<string, string>, env: string, secret_key: string} $config */
    $config = require $root . '/config/config.php';

    $pdo = Db::connect($config['db']);

    // =====================================================================
    // Migracije
    // =====================================================================
    if ($command === 'migrate' || $command === 'migrate:status') {
        $migrator = new Migrator($pdo, $config['paths']['migrations']);
        $migrator->ensureTable();

        $drift = $migrator->drift();

        if ($drift !== []) {
            $stderr('GRESKA: izmenjene su migracije koje su vec primenjene.');
            $stderr();

            foreach ($drift as $item) {
                $stderr("  {$item['version']}  {$item['name']}");
            }

            $stderr();
            $stderr('Primenjena migracija se ne menja — baza na ovoj i na drugim');
            $stderr('masinama sada ima istu oznaku verzije a razlicitu semu.');
            $stderr('Vrati fajl u prvobitno stanje i ispravku dodaj kao novu verziju.');

            exit(2);
        }

        $applied = $migrator->applied();
        $pending = $migrator->pending();

        if ($command === 'migrate:status') {
            $stdout('Primenjene migracije: ' . count($applied));

            foreach ($applied as $row) {
                $stdout(sprintf('  [x] %s  %-28s %s UTC', $row['version'], $row['name'], $row['applied_at']));
            }

            $stdout();
            $stdout('Neprimenjene migracije: ' . count($pending));

            foreach ($pending as $migration) {
                $stdout(sprintf('  [ ] %s  %s', $migration['version'], $migration['name']));
            }

            $stdout();
            exit(0);
        }

        if ($pending === []) {
            $stdout('Nema novih migracija. Baza je azurna (' . count($applied) . ' primenjeno).');
            exit(0);
        }

        $stdout('Primenjujem ' . count($pending) . ' migracija...');
        $stdout();

        foreach ($pending as $migration) {
            $label = sprintf('  %s  %s', $migration['version'], $migration['name']);

            try {
                $durationMs = $migrator->apply($migration);
                $stdout($label . str_repeat(' ', max(1, 40 - strlen($label))) . "OK ({$durationMs} ms)");
            } catch (Throwable $e) {
                $stdout($label . str_repeat(' ', max(1, 40 - strlen($label))) . 'GRESKA');
                $stderr();
                $stderr('Migracija ' . $migration['version'] . ' nije uspela:');
                $stderr('  ' . $e->getMessage());
                $stderr();
                $stderr('PAZNJA: MySQL ne povlaci DDL unazad. Ako je ovaj fajl sadrzao');
                $stderr('vise naredbi, deo je mozda vec primenjen. Proveri stanje seme');
                $stderr('pre ponovnog pokretanja.');

                exit(1);
            }
        }

        $stdout();
        $stdout('Gotovo. Ukupno primenjeno: ' . (count($applied) + count($pending)) . '.');
        exit(0);
    }

    // =====================================================================
    // Integracije
    // =====================================================================
    $secret = new Secret($config['secret_key']);
    $repo   = new IntegrationRepository($pdo, $secret);

    // --- integrations --------------------------------------------------
    if ($command === 'integrations') {
        $integrations = $repo->all();

        if ($integrations === []) {
            $stdout('Nema unetih integracija. Dodaj prvu sa: bin/syncops integration:add');
            exit(0);
        }

        $stdout(sprintf(
            '%-4s %-22s %-32s %-9s %-12s %s',
            'ID', 'NAZIV', 'ADRESA', 'STANJE', 'DIJALEKT', 'POSLEDNJA PROVERA'
        ));
        $stdout(str_repeat('-', 104));

        foreach ($integrations as $i) {
            $test = $i->lastTestedAt === null
                ? 'nije provereno'
                : ($i->lastTestOk ? 'OK ' : 'GRESKA ') . $i->lastTestedAt;

            $stdout(sprintf(
                '%-4d %-22s %-32s %-9s %-12s %s',
                $i->id,
                mb_strimwidth($i->name, 0, 22, '..'),
                mb_strimwidth($i->baseUrl(), 0, 32, '..'),
                $i->isActive ? 'aktivna' : 'iskljucena',
                $i->effectiveFlavor() ?? 'nepoznat',
                $test
            ));
        }

        $stdout();
        exit(0);
    }

    // --- integration:add -------------------------------------------------
    if ($command === 'integration:add') {
        $stdout('Nova vCenter integracija.');
        $stdout();

        $hostname = $ask('FQDN ili IP vCentera');

        if ($hostname === '') {
            $stderr('Adresa je obavezna.');
            exit(1);
        }

        $name     = $ask('Prikazno ime', $hostname);
        $port     = (int) $ask('Port', '443');
        $username = $ask('Korisnicko ime (read-only nalog)');

        if ($username === '') {
            $stderr('Korisnicko ime je obavezno.');
            exit(1);
        }

        $password = $askSecret('Lozinka');

        if ($password === '') {
            $stderr('Lozinka je obavezna.');
            exit(1);
        }

        $stdout();
        $stdout('Dijalekt API-ja: auto (preporuceno), rest_legacy (6.7-7.0), api_v2 (7.0U2+)');
        $flavor = $ask('Dijalekt', Integration::FLAVOR_AUTO);

        if (!in_array($flavor, [Integration::FLAVOR_AUTO, Integration::FLAVOR_REST_LEGACY, Integration::FLAVOR_API_V2], true)) {
            $stderr("Nepoznat dijalekt: {$flavor}");
            exit(1);
        }

        $verifyPeer = $askYesNo('Proveravati TLS sertifikat?', false);

        $id = $repo->create(
            name:       $name,
            hostname:   $hostname,
            username:   $username,
            password:   $password,
            port:       $port,
            apiFlavor:  $flavor,
            verifyPeer: $verifyPeer,
        );

        $stdout();
        $stdout("Integracija je dodata pod ID {$id}.");
        $stdout('Lozinka je sacuvana enkriptovano i vise se nigde ne ispisuje.');
        exit(0);
    }

    // --- sklapanje runner-a, deljeno izmedju discover i worker -------------
    $makeRunner = static fn (): DiscoveryRunner => new DiscoveryRunner(
        $pdo,
        $repo,
        new RunRepository($pdo),
        new VCenterSource(new ClientFactory(timeout: 60)),
        new RawStore($pdo),
        new ClusterRepository($pdo),
        new HostRepository($pdo),
        new VmRepository($pdo),
    );

    // --- worker -----------------------------------------------------------
    if ($command === 'worker') {
        $worker = new Worker(
            new RunRepository($pdo),
            $repo,
            $makeRunner(),
            static function (string $line) use ($stdout): void {
                $stdout('[' . gmdate('Y-m-d H:i:s') . ' UTC] ' . $line);
            },
        );

        $worker->run();
        exit(0);
    }

    // --- discover:queue --all ---------------------------------------------
    if ($command === 'discover:queue' && $argument === '--all') {
        $runner = $makeRunner();
        $queued = 0;

        foreach ($repo->all(onlyActive: true) as $active) {
            try {
                $runId = $runner->enqueue($active, RunStatus::TRIGGER_SCHEDULE);
                $stdout(sprintf('  %-24s posao #%d u redu cekanja', $active->name, $runId));
                $queued++;
            } catch (Throwable $e) {
                $stdout(sprintf('  %-24s preskocena: %s', $active->name, $e->getMessage()));
            }
        }

        $stdout();
        $stdout($queued === 0
            ? 'Nijedan posao nije dodat u red.'
            : "U red je dodato poslova: {$queued}.");

        exit(0);
    }

    // --- komande koje zahtevaju <id> --------------------------------------
    if ($argument === null || !ctype_digit($argument)) {
        $stderr("Komanda {$command} zahteva ID integracije.");
        $stderr("Primer: bin/syncops {$command} 1");
        exit(1);
    }

    $id = (int) $argument;

    // runs:reset prima broj POSLA, ne integracije, pa ide pre trazenja
    // integracije po tom broju.
    if ($command === 'runs:reset') {
        $runs = new RunRepository($pdo);
        $run  = $runs->find($id);

        if ($run === null) {
            $stderr("Posao #{$id} ne postoji.");
            exit(1);
        }

        if (RunStatus::isFinished((string) $run['status'])) {
            $stdout("Posao #{$id} je vec zavrsen sa ishodom: {$run['status']}. Nema sta da se oslobodi.");
            exit(0);
        }

        $runs->finish($id, RunStatus::FAILED, 'Rucno oznacen kao neuspeo preko runs:reset.');

        $stdout("Posao #{$id} je oznacen kao neuspeo.");
        $stdout("Integracija {$run['integration_id']} je otkljucana i moze ponovo da se prikuplja.");
        exit(0);
    }

    $integration = $repo->find($id);

    if ($integration === null) {
        $stderr("Integracija {$id} ne postoji.");
        exit(1);
    }

    if ($command === 'integration:test') {
        $stdout("Povezujem se na {$integration->baseUrl()} kao {$integration->username} ...");
        $stdout();

        $tester = new ConnectionTester($repo, new ClientFactory());
        $result = $tester->test($integration);

        if (!$result->ok) {
            $stderr('NEUSPESNO');
            $stderr();
            $stderr('  ' . $result->message);
            exit(1);
        }

        $stdout('USPESNO');
        $stdout();
        $stdout(sprintf('  dijalekt API-ja   %s', $result->flavor));
        $stdout(sprintf('  verzija vCentera  %s', $result->productVersion ?? 'nedostupna (nalog nema prava na /appliance)'));
        $stdout(sprintf('  HTTP poziva       %d', $result->callCount));
        $stdout();

        foreach ($result->counts as $label => $value) {
            $stdout(sprintf('  %-14s %s', $label, $value === null ? 'preko limita liste' : $value));
        }

        if ($result->notes !== []) {
            $stdout();
            $stdout('Napomene:');

            foreach ($result->notes as $note) {
                $stdout('  - ' . $note);
            }
        }

        $stdout();
        exit(0);
    }

    if ($command === 'collect:dry') {
        $stdout("Prikupljam sa {$integration->baseUrl()} — NISTA SE NE UPISUJE U BAZU.");
        $stdout();

        $source = new VCenterSource(new ClientFactory(timeout: 60));

        $phase = '';
        $result = $source->collect($integration, $repo->password($integration->id), function (string $p, int $done, int $total) use (&$phase, $stdout): void {
            if ($p !== $phase) {
                $phase = $p;
                fwrite(STDOUT, '  ' . $p . ' ');
            }

            if ($total > 0) {
                // Tacka na svakih 10 masina, da ispis ne bude kilometar dugacak.
                if ($done % 10 === 0 || $done === $total) {
                    fwrite(STDOUT, '.');
                }

                if ($done === $total) {
                    $stdout(' ' . $total);
                }
            } else {
                $stdout('...');
            }
        });

        $stdout();
        $stdout(sprintf(
            'Gotovo za %.1f s, %d HTTP poziva (%s%s).',
            $result->durationSeconds,
            $result->apiCalls,
            $result->flavor,
            $result->productVersion !== null ? ' ' . $result->productVersion : ''
        ));
        $stdout();

        // --- Klasteri -----------------------------------------------------
        $stdout('KLASTERI (' . count($result->clusters) . ')');
        $stdout(sprintf('  %-14s %-26s %-18s %-4s %-4s', 'MOREF', 'NAZIV', 'DATACENTAR', 'HA', 'DRS'));

        foreach ($result->clusters as $c) {
            $stdout(sprintf(
                '  %-14s %-26s %-18s %-4s %-4s',
                $c->moref,
                mb_strimwidth($c->name, 0, 26, '..'),
                mb_strimwidth((string) $c->datacenterName, 0, 18, '..'),
                $c->haEnabled === null ? '?' : ($c->haEnabled ? 'da' : 'ne'),
                $c->drsEnabled === null ? '?' : ($c->drsEnabled ? 'da' : 'ne')
            ));
        }

        // --- Hostovi ------------------------------------------------------
        $stdout();
        $stdout('HOSTOVI (' . count($result->hosts) . ')');
        $stdout(sprintf('  %-10s %-34s %-16s %-13s %-14s', 'MOREF', 'NAZIV', 'STANJE', 'NAPAJANJE', 'KLASTER'));

        foreach ($result->hosts as $h) {
            $stdout(sprintf(
                '  %-10s %-34s %-16s %-13s %-14s',
                $h->moref,
                mb_strimwidth($h->name, 0, 34, '..'),
                (string) $h->connectionState,
                $h->powerState ?? '—',
                (string) $h->clusterMoref
            ));
        }

        $withHw = count(array_filter($result->hosts, static fn ($h) => $h->hardwareSource !== null));
        $stdout(sprintf('  hardverski podaci: %d / %d (REST ih nema)', $withHw, count($result->hosts)));

        // --- Masine -------------------------------------------------------
        $stdout();
        $stdout('MASINE (' . count($result->vms) . ') — prvih 15');
        $stdout(sprintf('  %-9s %-26s %-12s %-5s %-8s %-16s %-15s', 'MOREF', 'NAZIV', 'NAPAJANJE', 'CPU', 'RAM GiB', 'HOSTNAME', 'IP'));

        foreach (array_slice($result->vms, 0, 15) as $v) {
            $stdout(sprintf(
                '  %-9s %-26s %-12s %-5s %-8s %-16s %-15s',
                $v->moref,
                mb_strimwidth($v->name, 0, 26, '..'),
                (string) $v->powerState,
                (string) $v->cpuCount,
                $v->memoryMib === null ? '?' : (string) round($v->memoryMib / 1024, 1),
                mb_strimwidth((string) $v->guestHostname, 0, 16, '..'),
                (string) $v->guestIpAddress
            ));
        }

        // --- Kvalitet podataka ----------------------------------------------
        $withUuid  = count(array_filter($result->vms, static fn ($v) => $v->instanceUuid !== null));
        $withIp    = count(array_filter($result->vms, static fn ($v) => $v->guestIpAddress !== null));
        $withHost  = count(array_filter($result->vms, static fn ($v) => $v->hostMoref !== null));
        $totalVms  = max(1, count($result->vms));

        $byGuest = [];

        foreach ($result->vms as $v) {
            $byGuest[$v->guestState ?? 'nepoznato'] = ($byGuest[$v->guestState ?? 'nepoznato'] ?? 0) + 1;
        }

        $stdout();
        $stdout('KVALITET PODATAKA');
        $stdout(sprintf('  instance_uuid     %d / %d', $withUuid, count($result->vms)));
        $stdout(sprintf('  IP adresa         %d / %d', $withIp, count($result->vms)));
        $stdout(sprintf('  smestaj na host   %d / %d', $withHost, count($result->vms)));

        foreach ($byGuest as $state => $count) {
            $stdout(sprintf('  gost: %-12s %d', $state, $count));
        }

        unset($totalVms);

        if ($result->failures !== []) {
            $stdout();
            $stdout('NEUSPESI (' . count($result->failures) . ') — run bi bio oznacen kao "partial"');

            foreach (array_slice($result->failures, 0, 10) as $failure) {
                $stdout('  - ' . $failure);
            }
        }

        $stdout();
        $stdout($result->isComplete()
            ? 'Prikupljanje je bilo potpuno.'
            : 'Prikupljanje je bilo DELIMICNO.');
        $stdout();

        unset($result);
        exit(0);
    }

    if ($command === 'discover') {
        $runs  = new RunRepository($pdo);
        $stale = $runs->stale();

        if ($stale !== []) {
            $stdout('Napomena: zatecen je run bez znaka zivota duze od 30 minuta:');

            foreach ($stale as $row) {
                $stdout(sprintf(
                    '  run #%d, integracija %d, poslednji znak zivota %s UTC',
                    $row['id'],
                    $row['integration_id'],
                    (string) ($row['heartbeat_at'] ?? $row['queued_at'])
                ));
            }

            $stdout('Oznaci ga kao neuspeo pre nego sto pokrenes nov nad istom integracijom.');
            $stdout();
        }

        $runner = new DiscoveryRunner(
            $pdo,
            $repo,
            $runs,
            new VCenterSource(new ClientFactory(timeout: 60)),
            new RawStore($pdo),
            new ClusterRepository($pdo),
            new HostRepository($pdo),
            new VmRepository($pdo),
        );

        $stdout("Prikupljam sa {$integration->baseUrl()} i upisujem u bazu.");
        $stdout();

        $phase = '';
        $outcome = $runner->run(
            $integration,
            RunStatus::TRIGGER_CLI,
            function (string $p, int $done, int $total) use (&$phase, $stdout): void {
                if ($p !== $phase) {
                    $phase = $p;
                    fwrite(STDOUT, '  ' . $p . ' ');
                }

                if ($total > 0) {
                    if ($done % 10 === 0 || $done === $total) {
                        fwrite(STDOUT, '.');
                    }

                    if ($done === $total) {
                        $stdout(' ' . $total);
                    }
                } else {
                    $stdout('...');
                }
            }
        );

        $stdout();
        $stdout(sprintf(
            'Run #%d zavrsen sa ishodom: %s (%.1f s, %d HTTP poziva).',
            $outcome->runId,
            strtoupper($outcome->status),
            $outcome->collection->durationSeconds,
            $outcome->collection->apiCalls
        ));
        $stdout();

        $stdout(sprintf('  %-10s %8s %8s %10s %10s', 'TIP', 'NADJENO', 'NOVIH', 'IZMENJENIH', 'ISTIH'));

        foreach ($outcome->stats as $type => $s) {
            $stdout(sprintf(
                '  %-10s %8d %8d %10d %10d',
                $type,
                $s['found'],
                $s['created'],
                $s['changed'],
                $s['unchanged']
            ));
        }

        if ($outcome->collection->failures !== []) {
            $stdout();
            $stdout('NEUSPESI (' . count($outcome->collection->failures) . '):');

            foreach (array_slice($outcome->collection->failures, 0, 10) as $failure) {
                $stdout('  - ' . $failure);
            }
        }

        $stdout();

        if (!$outcome->isSuccess()) {
            $stdout('Run nije potpun — kasnija obrada ne sme da zakljucuje da je objekat obrisan');
            $stdout('na osnovu last_seen iz ovog run-a.');
            $stdout();
        }

        exit($outcome->isSuccess() ? 0 : 1);
    }

    if ($command === 'discover:queue') {
        $runId = $makeRunner()->enqueue($integration, RunStatus::TRIGGER_CLI);

        $stdout("Posao #{$runId} je u redu cekanja za {$integration->name}.");
        $stdout('Pokupice ga worker. Ako worker ne radi: docker compose up -d worker');
        exit(0);
    }

    if ($command === 'integration:password') {
        $password = $askSecret("Nova lozinka za {$integration->name}");

        if ($password === '') {
            $stderr('Lozinka ne sme biti prazna.');
            exit(1);
        }

        $repo->updatePassword($id, $password);
        $stdout('Lozinka je promenjena.');
        exit(0);
    }

    if ($command === 'integration:enable' || $command === 'integration:disable') {
        $active = $command === 'integration:enable';

        $repo->setActive($id, $active);
        $stdout(sprintf(
            'Integracija %s je %s.',
            $integration->name,
            $active ? 'aktivirana' : 'iskljucena'
        ));
        exit(0);
    }

    exit(0);
} catch (Throwable $e) {
    $stderr('GRESKA: ' . $e->getMessage());

    if (($config['env'] ?? 'dev') === 'dev') {
        $stderr();
        $stderr($e->getTraceAsString());
    }

    exit(1);
}
