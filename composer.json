{
    "name": "alennikolic/syncops",
    "description": "Prikupljanje podataka o infrastrukturi iz vise izvora radi sinhronizacije sa CMDB bazom",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-sodium": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SyncOps\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SyncOps\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src public bin -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
