# .env.example
#
# Kopirati u .env i popuniti:   cp .env.example .env
# .env NE IDE u git (vidi .gitignore).

# --- Aplikacija ------------------------------------------------------
APP_ENV=dev

# Port na kojem je GUI dostupan na host masini
WEB_PORT=8080

# --- Baza ------------------------------------------------------------
DB_NAME=syncops
DB_USER=syncops
DB_PASSWORD=promeni_me
DB_ROOT_PASSWORD=promeni_me_takodje

# Port na koji se MySQL mapira na host masini (za DBeaver/HeidiSQL).
# 3307 da ne bi doslo do sudara sa lokalnim MySQL-om na 3306.
DB_PORT_HOST=3307

# --- Pristup GUI-ju --------------------------------------------------
# bcrypt hash lozinke kojom se ulazi u GUI. Generisati sa:
#   docker compose exec app php bin/syncops password:hash
#
# Dok je prazno, GUI je zatvoren i prikazuje uputstvo umesto forme.
# Hash sadrzi znak $, pa MORA biti pod jednostrukim navodnicima.
APP_PASSWORD_HASH=''

# --- Kriptografija ---------------------------------------------------
# Kljuc kojim se enkriptuju vCenter kredencijali u bazi.
# Generisati sa:
#   docker compose exec app php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
#
# PAZNJA: ako se ovaj kljuc izgubi ili promeni, svi sacuvani vCenter
# kredencijali postaju nedesifrabilni i moraju se uneti ponovo.
SECRET_KEY=
